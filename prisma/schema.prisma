// 1. DATASOURCE
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 2. GENERATOR
generator client {
  provider = "prisma-client-js"
}

// 3. DATA MODELS
// Using UUIDs for all primary keys for security (non-predictable IDs)

model Rental {
  id         String    @id @default(uuid())
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     String    @default("PENDING")
  userId     String
  carId      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  car        Car       @relation(fields: [carId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, carId, startDate])
  @@index([userId])
  @@index([carId])
  @@index([status])
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String
  role                 String    @default("GUEST")
  imageUrl             String?
  drivingLicenceNumber String?   // Optional - required only for rentals
  refreshToken         String?   // For refresh token mechanism (stored as hash)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  rentals              Rental[]

  @@index([email])
}

model Car {
  id          String    @id @default(uuid())
  make        String
  model       String
  year        Int
  color       String
  pricePerDay Float
  available   Boolean   @default(true)
  imageUrl    String?   // Primary/main image (for backward compatibility)
  fuelType    String?   // e.g., "Petrol", "Diesel", "Electric", "Hybrid"
  transmission String?  // e.g., "Manual", "Automatic", "CVT"
  seats       Int?      // Number of seats
  engine      String?   // Engine details (e.g., "2.0L Turbo", "V6")
  mileage     Int?      // Current mileage in km
  description String?   // Detailed description of the car
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  rentals     Rental[]
  images      CarImage[] // Multiple images per car

  @@index([available])
  @@index([make])
}

model CarImage {
  id        String    @id @default(uuid())
  carId     String
  imageUrl  String    // Path to the uploaded image
  isPrimary Boolean   @default(false) // Mark one image as primary
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  car       Car       @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
}